# 1 — сервис за реверс-прокси (Caddy дописывает X-Forwarded-For).
# 0 — сервис торчит наружу напрямую (IP берётся из сокета).
TRUST_PROXY=1
# 1 — верить CF-Connecting-IP (Cloudflare Tunnel, приоритет выше XFF).
# 0 — игнорировать (если CF-заголовок могут подделать в обход туннеля).
TRUST_CF=1
# где лежат .mmdb (в compose примонтировано ./geo)
GEO_DIR=/app/geo
# таймаут серверного rDNS (только при неизвестной ASN-орге), сек
RDNS_TIMEOUT=1.5
# запросов с одного IP за скользящую минуту, 0 — без лимита
RATE_LIMIT_PER_MINUTE=6000
PORT=8000
# логи: info / warn / error / debug
RUST_LOG=info
