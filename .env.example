# 1 — the service runs behind a reverse proxy (Caddy/nginx/Cloudflare add X-Forwarded-For).
# 0 — the service faces the internet directly: IP comes from the socket only, headers untrusted.
# Flags accept 1/0, true/false, yes/no, on/off; a typo stops startup.
TRUST_PROXY=1
# 1 — trust CF-Connecting-IP. Only when traffic really arrives through
# Cloudflare/Tunnel; requires TRUST_PROXY=1. On plain Caddy/VPS keep 0,
# otherwise any client can spoof the IP/geo and the rate-limit key.
# 0 — ignore CF headers (the safe default).
# Cloudflare Tunnel: TRUST_PROXY=1 and TRUST_CF=1.
TRUST_CF=0
# where the .mmdb files live (compose mounts ./geo)
GEO_DIR=/app/geo
# server-side rDNS timeout (only when the ASN org is unknown), seconds, 0 (off) to 10
RDNS_TIMEOUT=1.5
# token bucket: burst and average request rate per client IP (IPv6 — per /64 network) per minute, 0 — no limit
RATE_LIMIT_PER_MINUTE=6000
# headers the reverse proxy adds itself (e.g. nginx with X-Real-IP),
# comma-separated; not attributed to the checked proxy. Empty for Caddy/Cloudflare.
EDGE_HEADERS=
# when set, /metrics requires Authorization: Bearer <token>
METRICS_TOKEN=
# fixed key for signing /judge answers (Ed25519): 32 random bytes in base64,
# openssl rand -base64 32; the public key is served at /key.
# Empty — a key generated at startup (changes on every restart). Set it to keep
# one key across restarts; required when several replicas share one address.
SIGNING_KEY=
PORT=8000
# listen address inside the container; :: also accepts IPv6
BIND_ADDR=0.0.0.0
# logs: info / warn / error / debug
RUST_LOG=info
