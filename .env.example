# 1 — сервис за реверс-прокси (Caddy/nginx/Cloudflare добавляют X-Forwarded-For).
# 0 — сервис торчит наружу напрямую: IP только из сокета, заголовки не доверяем.
# Флаги принимают 1/0, true/false, yes/no, on/off; опечатка остановит старт.
TRUST_PROXY=1
# 1 — верить CF-Connecting-IP. Только если трафик реально идёт через
# Cloudflare/Tunnel; требует TRUST_PROXY=1. На обычном Caddy/VPS оставь 0,
# иначе любой клиент подделает IP/гео и ключ rate-limit.
# 0 — игнорировать CF-заголовки (безопасный дефолт).
# Cloudflare Tunnel: TRUST_PROXY=1 и TRUST_CF=1.
TRUST_CF=0
# где лежат .mmdb (в compose примонтировано ./geo)
GEO_DIR=/app/geo
# таймаут серверного rDNS (только при неизвестной ASN-орге), сек
RDNS_TIMEOUT=1.5
# token bucket: burst и средний темп запросов с одного IP (IPv6 — с сети /64) в минуту, 0 — без лимита
RATE_LIMIT_PER_MINUTE=6000
# заголовки, которые добавляет сам реверс-прокси (например, nginx с X-Real-IP),
# через запятую; не приписываются проверяемому прокси. Пусто для Caddy/Cloudflare.
EDGE_HEADERS=
# если задан, /metrics требует Authorization: Bearer <токен>
METRICS_TOKEN=
PORT=8000
# адрес прослушивания внутри контейнера; :: — ещё и IPv6
BIND_ADDR=0.0.0.0
# логи: info / warn / error / debug
RUST_LOG=info
