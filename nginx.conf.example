# nginx in front of proxpulse-judge (the Caddyfile.example equivalent).
# In .env: TRUST_PROXY=1, TRUST_CF=0. The judge listens on 127.0.0.1 (docker-compose.yml).
#
# IMPORTANT: X-Real-IP, Via and Forwarded must not be added here (nginx templates
# often set them): the judge treats them as proxy telltales and every check would
# come out "anonymous". If they cannot be avoided, list them in EDGE_HEADERS
# (e.g. EDGE_HEADERS=x-real-ip) so they are not attributed
# to the checked proxy. The realip module (set_real_ip_from) is not needed either.
#
# Certificate: certbot certonly --nginx -d check.yourdomain.com (or any ACME client).
# Not plain `certbot --nginx`: its redirect step adds a server-level
# `return 301` to the port-80 block, which runs before the locations below
# and sends /judge to HTTPS again.

# Anonymity is only visible over plain HTTP: inside HTTPS the proxy cannot add
# headers. So the echo endpoints also answer on port 80, and everything else
# (/key above all) is redirected to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name check.yourdomain.com;

    location ~ ^/(judge|content|headers|ip)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name check.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/check.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/check.yourdomain.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Appends the connecting address to the chain the checked
        # proxy sent: the judge takes the last entry as the client IP
        # and analyses the rest for leaks.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # CF-Connecting-IP and True-Client-IP pass through: with TRUST_CF=0
        # (the default, no Cloudflare here) the judge never takes the client
        # address from them, it only searches them for a leaked real IP.
        # If Cloudflare sits IN FRONT OF nginx, allow only Cloudflare ranges
        # on 80/443 (or Authenticated Origin Pulls) and set TRUST_CF=1.
    }
}
