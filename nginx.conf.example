# nginx перед proxpulse-judge (аналог Caddyfile.example).
# В .env: TRUST_PROXY=1, TRUST_CF=0. judge слушает 127.0.0.1 (docker-compose.yml).
#
# ВАЖНО: не добавляй сюда X-Real-IP, Via или Forwarded (их часто кладут
# шаблоны nginx): judge считает их признаками прокси, и все проверки выйдут
# "anonymous". Если без них никак — перечисли их в EDGE_HEADERS
# (например, EDGE_HEADERS=x-real-ip), чтобы они не приписывались
# проверяемому прокси. Модуль realip (set_real_ip_from) тоже не нужен.
#
# Сертификат: certbot --nginx -d check.yourdomain.com (или любой ACME-клиент).
server {
    listen 80;
    listen [::]:80;
    server_name check.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name check.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/check.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/check.yourdomain.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Дописывает адрес подключившегося к цепочке, которую прислал
        # проверяемый прокси: judge берёт последнюю запись как IP клиента,
        # а остальные анализирует на утечки.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Cloudflare перед nginx нет: не даём подделать CF-заголовки.
        # Если Cloudflare стоит ПЕРЕД nginx, удали эти две строки, пусти на
        # 80/443 только диапазоны Cloudflare (или Authenticated Origin Pulls)
        # и включи TRUST_CF=1.
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
    }
}
