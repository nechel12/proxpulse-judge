# Caddy is installed SEPARATELY (on the host or as its own container).
# A dedicated subdomain is expected (an A-record for the subdomain -> this server's IP).
#
# IMPORTANT: Caddy 2.5+ does NOT trust the incoming X-Forwarded-For by default
# and replaces it with the immediate client's IP. The judge would then not
# see the real IP the checked proxy put into XFF and report a false elite.
# trusted_proxies below restores the chain; that is
# safe only because the judge listens on 127.0.0.1 (see
# docker-compose.yml) rather than facing the internet directly.
#
# Caddy still appends the real peer last, so the judge
# uses the last entry for the IP and the earlier ones for leak analysis.
check.yourdomain.com {
    reverse_proxy 127.0.0.1:8000 {
        trusted_proxies 0.0.0.0/0 ::/0
        # Caddy does not use Cloudflare: nobody may forge CF headers.
        # If Cloudflare sits IN FRONT OF Caddy, remove these two lines,
        # set trusted_proxies to Cloudflare's ranges, restrict ports
        # 80/443 to Cloudflare addresses only (firewall or
        # Authenticated Origin Pulls: trusted_proxies governs only
        # X-Forwarded-*, not CF-Connecting-IP) and set TRUST_CF=1.
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
    }
}
