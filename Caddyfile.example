# Caddy ставится ОТДЕЛЬНО (на хосте или своим контейнером).
# Подставь свой поддомен (A-запись поддомена -> IP этого сервера).
#
# ВАЖНО: Caddy 2.5+ по умолчанию НЕ доверяет входящему X-Forwarded-For
# и заменяет его IP-адресом непосредственного клиента. Тогда judge не
# увидит реальный IP, который проверяемый прокси положил в XFF, и выдаст
# ложный elite. trusted_proxies ниже включает сохранение цепочки; это
# безопасно только потому, что judge слушает 127.0.0.1 (см.
# docker-compose.yml), а не смотрит в интернет напрямую.
#
# Caddy всё равно добавляет реальный peer последним, поэтому judge
# использует последнюю запись для IP, а предыдущие — для анализа утечек.
check.yourdomain.com {
    reverse_proxy 127.0.0.1:8000 {
        trusted_proxies 0.0.0.0/0 ::/0
        # Caddy не использует Cloudflare: не даём подделать CF-заголовки.
        # Если Cloudflare стоит ПЕРЕД Caddy, удали эти две строки,
        # настрой trusted_proxies диапазонами Cloudflare и включи TRUST_CF=1.
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
    }
}
